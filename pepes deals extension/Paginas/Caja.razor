                @if (datos?.HistoricosOficiales?.Count > 0)
                {
                    <div class="pepeizq-caja-info">
                        <div style="background-color: rgba(0,0,0,.5); padding: 10px 15px; border-top-left-radius: inherit; border-top-right-radius: inherit; @(cajasContador > 1 ? "text-align: center" : "");">
                            @WebExtensions.I18n.GetMessage("String28")
                        </div>
                
                        <div style="padding: 10px 15px; display: flex; flex-direction: column; gap: 20px;">
                            @if (minimoHistoricoOficial != null)
                            {
                                string mensajeMinimo = string.Empty;

                                if (mejorActualOficial != null)
                                {
                                    if (mejorActualOficial.Datos.Precio == minimoHistoricoOficial.Datos.Precio && mejorActualOficial.Datos.Tienda == minimoHistoricoOficial.Datos.Tienda)
                                    {
                                        mensajeMinimo = string.Format(WebExtensions.I18n.GetMessage("String5"), minimoHistoricoOficial.Tienda);
                                    }
                                }

                                if (string.IsNullOrEmpty(mensajeMinimo) == true)
                                {
                                    mensajeMinimo = string.Format(WebExtensions.I18n.GetMessage("String4"), Herramientas.Calculadora.DiferenciaHaceTiempo(minimoHistoricoOficial.Datos.FechaDetectado, WebExtensions.I18n), minimoHistoricoOficial.Tienda);
                                }

                                if (string.IsNullOrEmpty(mensajeMinimo) == false)
                                {
                                    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; @(cajasContador > 1 ? "justify-content: center;" : "")">
                                        <div>
                                            @WebExtensions.I18n.GetMessage("String3")
                                        </div>

                                        <div style="background: rgba(0,0,0,.7); padding: 5px 10px">
                                            @if (prefs.Divisa == "eu")
                                            {
                                                if (minimoHistoricoOficial.Datos.PrecioCambiado > 0)
                                                {
                                                    @Herramientas.Precios.Euro(minimoHistoricoOficial.Datos.PrecioCambiado)
                                                }
                                                else
                                                {
                                                    @Herramientas.Precios.Euro(minimoHistoricoOficial.Datos.Precio)
                                                }
                                            }
                                            else if (prefs.Divisa == "us")
                                            {
                                                if (minimoHistoricoOficial.Datos.PrecioCambiado > 0)
                                                {
                                                    @Herramientas.Precios.Dolar(minimoHistoricoOficial.Datos.PrecioCambiado)
                                                }
                                                else
                                                {
                                                    @Herramientas.Precios.Dolar(minimoHistoricoOficial.Datos.Precio)
                                                }
                                            }
                                        </div>

                                        @if (cajasContador == 1)
                                        {
                                            <div style="font-size: 14px;">
                                                @mensajeMinimo
                                            </div>
                                        }
                                    </div>
                                }
                            }

                            @if (mejorActualOficial == null)
                            {
                                <div>
                                    @WebExtensions.I18n.GetMessage("String2")
                                </div>
                            }
                            else
                            {
                                bool enseñarEnlace = true;

                                if (idDRM == 0 && mejorActualOficial.Tienda == "steam")
                                {
                                    enseñarEnlace = false;
                                }

                                if (idDRM == 8 && mejorActualOficial.Tienda == "gog")
                                {
                                    enseñarEnlace = false;
                                }

                                if (idDRM == 6 && mejorActualOficial.Tienda == "epicgamesstore")
                                {
                                    enseñarEnlace = false;
                                }

                                if (enseñarEnlace == true)
                                {
                                    <div style="display: flex; flex-direction: column; gap: 5px;">
                                        <div style="@(cajasContador > 1 ? "text-align: center" : "");">
                                            @WebExtensions.I18n.GetMessage("String6")
                                        </div>

                                        <button class="pepedeals-enlace" @onclick="(e => AbrirEnlace(e, mejorActualOficial.Datos.Enlace, mejorActualOficial.Datos.CodigoTexto))">
                                            <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap; justify-content: @(cajasContador > 1 ? "center":"space-between");">
                                                <div style="display: flex; align-items: center; gap: 15px; @(cajasContador > 1 ? "width: 100%; justify-content: center;" : "")">
                                                    <img src="https://pepe.deals/@mejorActualOficial.TiendaIcono" style="max-width: 20px; max-height: 20px;" />

                                                    @if (idDRM == 0)
                                                    {
                                                        <div>
                                                            @mejorActualOficial.Tienda
                                                        </div>
                                                    }
                                                </div>

                                                @if (mejorActualOficial.Datos.Descuento > 0)
                                                {
                                                    <div style="padding: 10px 15px; background-color: var(--descuento); @(cajasContador == 1 ? "margin-left: auto" : "");">
                                                        @mejorActualOficial.Datos.Descuento%
                                                    </div>
                                                }

                                                <div style="padding: 10px 15px;">
                                                    @if (prefs.Divisa == "eu")
                                                    {
                                                        if (mejorActualOficial.Datos.PrecioCambiado > 0)
                                                        {
                                                            @Herramientas.Precios.Euro(mejorActualOficial.Datos.PrecioCambiado)
                                                        }
                                                        else
                                                        {
                                                            @Herramientas.Precios.Euro(mejorActualOficial.Datos.Precio)
                                                        }
                                                    }
                                                    else if (prefs.Divisa == "us")
