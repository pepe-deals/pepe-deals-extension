    private async void AbrirEnlace(MouseEventArgs e, string enlace, string codigo = null)
    {
        if (string.IsNullOrEmpty(codigo) == false)
        {
            mostrarAviso = true;

            avisoEnlace = enlace;
            avisoCodigo = codigo;
        }
        else
        {
            mostrarAviso = false;

            try
            {
                await JavaScript.InvokeVoidAsync("open", enlace, "_blank");
            }
            catch { }
        }        
    }

