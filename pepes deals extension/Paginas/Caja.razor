                                        @if (cajasContador == 1)
                                        {
                                            <div style="font-size: 14px;">
                                                @mensajeMinimo
                                            </div>
                                        }
                                    </div>
                                }
                            }

                            @if (mejorActualMarketplace == null)
                            {
                                <div>
                                    @WebExtensions.I18n.GetMessage("String2")
                                </div>
                            }
                            else
                            {
                                bool enseñarEnlace = true;

                                if (idDRM == 0 && mejorActualMarketplace.Tienda == "steam")
                                {
                                    enseñarEnlace = false;
                                }

                                if (idDRM == 8 && mejorActualMarketplace.Tienda == "gog")
                                {
                                    enseñarEnlace = false;
                                }

                                if (idDRM == 6 && mejorActualMarketplace.Tienda == "epicgamesstore")
                                {
                                    enseñarEnlace = false;
                                }

                                if (enseñarEnlace == true)
                                {
                                    <div style="display: flex; flex-direction: column; gap: 5px;">
                                        <div style="@(cajasContador > 1 ? "text-align: center" : "");">
                                            @WebExtensions.I18n.GetMessage("String6")
                                        </div>

                                        <button class="pepedeals-enlace" @onclick="(e => AbrirEnlace(e, mejorActualMarketplace.Datos.Enlace, mejorActualMarketplace.Datos.CodigoTexto))">
                                            <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap; justify-content: @(cajasContador > 1 ? "center" : "space-between");">
                                                <div style="display: flex; align-items: center; gap: 15px; @(cajasContador > 1 ? "width: 100%; justify-content: center;" : "")">
                                                    <img src="https://pepe.deals/@mejorActualMarketplace.TiendaIcono" style="max-width: 20px; max-height: 20px;" />

                                                    @if (idDRM == 0)
                                                    {
                                                        <div>
                                                            @mejorActualMarketplace.Tienda
                                                        </div>
                                                    }
                                                </div>

                                                @if (mejorActualMarketplace.Datos.Descuento > 0)
                                                {
                                                    <div style="padding: 10px 15px; background-color: var(--descuento); @(cajasContador == 1 ? "margin-left: auto" : "");">
                                                        @mejorActualMarketplace.Datos.Descuento%
                                                    </div>
                                                }

                                                <div style="padding: 10px 15px;">
                                                    @if (prefs.Divisa == "eu")
                                                    {
                                                        if (mejorActualMarketplace.Datos.PrecioCambiado > 0)
                                                        {
                                                            @Herramientas.Precios.Euro(mejorActualMarketplace.Datos.PrecioCambiado)
                                                        }
                                                        else
                                                        {
                                                            @Herramientas.Precios.Euro(mejorActualMarketplace.Datos.Precio)
                                                        }
                                                    }
                                                    else if (prefs.Divisa == "us")
                                                    {
                                                        if (mejorActualMarketplace.Datos.PrecioCambiado > 0)
                                                        {
                                                            @Herramientas.Precios.Dolar(mejorActualMarketplace.Datos.PrecioCambiado)
                                                        }
                                                        else
                                                        {
                                                            @Herramientas.Precios.Dolar(mejorActualMarketplace.Datos.Precio)
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@if (mostrarAviso == true)
{
    <div class="pepedeals-aviso-panel">
        <div style="max-width: 600px; width: 100%; background-color: var(--fondoSubcabecera); border: 1px solid var(--fondoBotonPequeño); margin: 20px auto; overflow-y: scroll; border-radius: 20px; box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.28),0px 0px 2px 0px rgba(0, 0, 0, 0.24);
                    padding: 30px; display: flex; justify-content: center; flex-direction: column; gap: 20px;">
            <div style="color: var(--colorTexto); font-size: 16px;">
                @string.Format(WebExtensions.I18n.GetMessage("String7"), avisoCodigo)
