                                if (idDRM == 0 && mejorActualNoOficial.Tienda == "steam")
                                {
                                    enseñarEnlace = false;
                                }

                                if (idDRM == 8 && mejorActualNoOficial.Tienda == "gog")
                                {
                                    enseñarEnlace = false;
                                }

                                if (idDRM == 6 && mejorActualNoOficial.Tienda == "epicgamesstore")
                                {
                                    enseñarEnlace = false;
                                }

                                if (enseñarEnlace == true)
                                {
                                    <div style="display: flex; flex-direction: column; gap: 5px;">
                                        <div style="@(cajasContador > 1 ? "text-align: center" : "");">
                                            @WebExtensions.I18n.GetMessage("String6")
                                        </div>

                                        <button class="pepedeals-enlace" @onclick="(e => AbrirEnlace(e, mejorActualNoOficial.Datos.Enlace, mejorActualNoOficial.Datos.CodigoTexto))">
                                            <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap; justify-content: @(cajasContador > 1 ? "center" : "space-between");">
                                                <div style="display: flex; align-items: center; gap: 15px; @(cajasContador > 1 ? "width: 100%; justify-content: center;" : "")">
                                                    <img src="https://pepe.deals/@mejorActualNoOficial.TiendaIcono" style="max-width: 20px; max-height: 20px;" />

                                                    @if (idDRM == 0)
